# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#030A00"

# Main text color
theme[main_fg]="#FEF2F4"

# Title color for boxes
theme[title]="#FEF2F4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a29cf3"

# Background color of selected item in processes box. #1c231a maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1c231a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1c231a"

# Foreground color of selected item in processes box. Use #FEF2F4 so
# the row text stays readable on the lighter_bg highlight; the previous
# #a29cf3 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#FEF2F4"

# Color of inactive/disabled text
theme[inactive_fg]="#5c5f59"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #fef4f6 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #FEF2F4 directly.
theme[graph_text]="#FEF2F4"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1c231a collapsed to the main fg.
theme[meter_bg]="#1c231a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #756dc9 for a distinct accent instead of #fef4f6 which capped to white.
theme[proc_misc]="#756dc9"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ab59ab"
theme[mem_box]="#efd46f"
theme[net_box]="#c7675d"
theme[proc_box]="#a29cf3"

# Box divider line and small boxes line color
theme[div_line]="#5c5f59"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#efd46f"
theme[temp_mid]="#6a8343"
theme[temp_end]="#c7675d"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#756dc9"
theme[cpu_mid]="#a29cf3"
theme[cpu_end]="#ab59ab"

# Mem/Disk free meter
theme[free_start]="#ab59ab"
theme[free_mid]="#a29cf3"
theme[free_end]="#756dc9"

# Mem/Disk cached meter
theme[cached_start]="#a29cf3"
theme[cached_mid]="#756dc9"
theme[cached_end]="#ab59ab"

# Mem/Disk available meter
theme[available_start]="#6a8343"
theme[available_mid]="#c7675d"
theme[available_end]="#c7675d"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#efd46f"
theme[used_mid]="#756dc9"
theme[used_end]="#a29cf3"

# Download graph colors
theme[download_start]="#6a8343"
theme[download_mid]="#c7675d"
theme[download_end]="#c7675d"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#efd46f"
theme[upload_mid]="#756dc9"
theme[upload_end]="#a29cf3"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#756dc9"
theme[process_mid]="#a29cf3"
theme[process_end]="#ab59ab"
